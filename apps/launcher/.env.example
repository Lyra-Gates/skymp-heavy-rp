# IP do servidor de jogo (onde o skse64_loader vai conectar)
VITE_SERVER_IP=127.0.0.1
# Porta do servidor (jogo)
VITE_SERVER_PORT=7757
# Porta da API do servidor (fila, mods.json, queue)
VITE_API_PORT=7758

# URL do painel web (apps/web). O launcher usa pra concluir o login do Discord.
VITE_PANEL_URL=http://127.0.0.1:3001

# Discord OAuth2
# NAO existe VITE_DISCORD_CLIENT_SECRET aqui: tudo que e VITE_* e embutido no
# instalador e pode ser extraido por qualquer jogador. O client secret fica so
# no apps/web/.env, que faz a troca do code por token.
VITE_DISCORD_CLIENT_ID=SEU_CLIENT_ID_AQUI
VITE_DISCORD_REDIRECT_URI=http://localhost:19847/callback

# Repositório de distribuição no GitHub (ex: tangoplaybr/skymp-dist)
VITE_GITHUB_DIST_REPO=seu-usuario/seu-repo-dist
