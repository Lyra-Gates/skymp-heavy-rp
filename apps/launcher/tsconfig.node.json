{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `electron/` estava fora de qualquer tsconfig: nem `npm run build` (que roda
  // `tsc`) nem o vite-plugin-electron (esbuild, que só transpila) checavam tipo
  // no processo main. Um erro de tipo em main.ts ia direto pro instalador.
  "include": ["vite.config.ts", "electron"]
}
