# Escolhe QUAL arquivo de opcoes de gameplay o servidor le:
# `skymp/config/server-options.<NODE_ENV>.json` (ver core/server-options.js).
#
# Precisa ser um dos ambientes que existem: `local`, `staging` ou `production`.
# Ate 06/08/2026 este exemplo dizia `development`, e nao existe
# `server-options.development.json` — o Initialize-LocalConfig.ps1 gera
# `server-options.local.json`. O boot avisava
# "server-options.development.json nao encontrado, usando defaults" e seguia,
# entao TODA opcao de gameplay do arquivo era ignorada em silencio: mexer em
# `permadeathEnabled`, nos raios de chat ou no `startingGold` nao fazia nada.
#
# Descoberto no primeiro boot real do servidor (Fase 0).
NODE_ENV=local
ALLOW_LOCAL_AUTOWHITELIST=false

# ─────────────────────────────────────────────────────────────────────────────
# Modulos. Estas sao as UNICAS flags que ligam alguma coisa: cada uma
# corresponde a um `enabledBy` de um descriptor registrado em phase0-basic.js
# (ver core/module-registry.js). Flag sem descriptor nao faz nada.
#
# A Fase 0 mantem tudo desligado por padrao — ver docs/technical/FASE_0_ROTEIRO.md
# pra quais ligar durante o teste in-game.
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_NPC_CLEANER=false
ENABLE_DEATH_SERVICE=false
ENABLE_GOVERNANCE_SERVICE=false
ENABLE_MARKET_STALLS_SERVICE=false
ENABLE_PLAYER_PANEL_SERVICE=false
ENABLE_VOIP_SERVICE=false

# Removidas em 06/08/2026: ENABLE_JUSTICE_SERVICE, ENABLE_FACTION_SERVICE e
# ENABLE_SURVIVAL_SERVICE. Os tres servicos foram APAGADOS (ver
# docs/technical/PARKED_SERVICES_DECISION.md) e as flags ficaram para tras —
# um arquivo de exemplo oferecendo o que nao existe mais convida a ligar e
# concluir que o servidor esta quebrado quando nada acontece.
#
# ENABLE_REGIONAL_ECONOMY tambem saiu: `economy-regional` esta PARKED e nao
# tem descriptor no registry, entao a flag nunca ligou o modulo. O que ela
# fazia era pior — o governance-service a lia direto de process.env pra
# carregar o modulo por fora do registry. Isso foi fechado; hoje quem responde
# e `moduleRegistry.isEnabled()`.
#
# Para reativar qualquer um deles: escreva o descriptor em phase0-basic.js.
# A flag e a ultima etapa, nunca a primeira.

# VOIP — servidor de sinalização WebSocket para voz por proximidade (/voz).
# BIND_HOST é onde o processo escuta (127.0.0.1 = só a própria máquina).
# PUBLIC_HOST é o que o servidor manda pro cliente conectar — troque pro IP
# público do servidor em produção, já que skymp/ui/index.html é estático e
# não tem como descobrir isso sozinho.
VOIP_PORT=7778
VOIP_BIND_HOST=127.0.0.1
VOIP_PUBLIC_HOST=127.0.0.1
